{
    "name": "omarsaiouf/integrations",
    "description": "dynamic integartions for APIs",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Omarsaiouf\\Integrations\\": "src/",
            "Omarsaiouf\\Integrations\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omarsaiouf\\Integrations\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Omar Saiouf",
            "email": "homar0083@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omarsaiouf\\Integrations\\IntegrationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
